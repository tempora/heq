<Window x:Class="Heq.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Heq.Controls"
        Title="heq" Height="660" Width="1040"
        MinHeight="460" MinWidth="860"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Grid>

    <c:EqCurveView x:Name="Curve" Margin="8,42,8,8" />

    <Border VerticalAlignment="Top" Height="52" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Offset="0" Color="#FF15120F" />
          <GradientStop Offset="0.75" Color="#EE15120F" />
          <GradientStop Offset="1" Color="#0015120F" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Border VerticalAlignment="Bottom" Height="120" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Offset="0" Color="#0015120F" />
          <GradientStop Offset="1" Color="#CC15120F" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <!-- ================= top chrome ================= -->
    <Grid VerticalAlignment="Top" Height="42" Margin="8,0,10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Button x:Name="MenuBtn" Grid.Column="0" Style="{StaticResource GhostBtn}"
              VerticalAlignment="Center" ToolTip="Presets">
        <Path Style="{StaticResource Icon}" Data="{StaticResource IconMenu}" />
      </Button>

      <TextBlock Grid.Column="1" Text="heq" FontSize="18" FontWeight="SemiBold"
                 Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
                 TextOptions.TextFormattingMode="Ideal"
                 VerticalAlignment="Center" Margin="8,0,0,0" />
    </Grid>

    <!-- ================= bottom chrome ================= -->
    <TextBlock x:Name="StatusText" Style="{StaticResource Label}"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,44"
               TextTrimming="CharacterEllipsis" MaxWidth="320" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,62,44">
      <ToggleButton x:Name="AbToggle" Style="{StaticResource AbSwitch}"
                    VerticalAlignment="Center" Margin="0,0,20,0" Opacity="0.4" />

      <TextBlock x:Name="PowerLabel" Text="EQ" Style="{StaticResource Label}"
                 FontSize="11" Margin="0,0,8,0" />
      <ToggleButton x:Name="PowerToggle" Style="{StaticResource EqSwitch}" IsChecked="True"
                    VerticalAlignment="Center" ToolTip="Bypass the EQ" />
    </StackPanel>

    <!-- ================= floating band card ================= -->
    <Grid VerticalAlignment="Bottom" Margin="0,0,0,40" Height="90">
      <Border x:Name="BandCard" HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="20" BorderThickness="1.4" BorderBrush="{StaticResource Edge}"
              Padding="12,8,12,8" Visibility="Collapsed" RenderTransformOrigin="0.5,1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF2E2620" />
            <GradientStop Offset="1" Color="#FF201A15" />
          </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
          <TranslateTransform x:Name="CardSlide" Y="0" />
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.6" Color="#FF000000" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal">

          <ToggleButton x:Name="BandBypass" Style="{StaticResource NodePower}" Content="1"
                        IsChecked="True" VerticalAlignment="Center" ToolTip="Bypass this band" />

          <Border Background="{StaticResource Sunken}" CornerRadius="13" Margin="12,0,12,0"
                  BorderThickness="1" BorderBrush="#FF120F0D" Padding="8,6,8,6"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel Width="88" VerticalAlignment="Center">
                <TextBox x:Name="FreqBox" Style="{StaticResource CardValue}" />
                <TextBlock Text="FREQ  Hz" Style="{StaticResource CellCaption}" />
              </StackPanel>

              <StackPanel Width="88" VerticalAlignment="Center">
                <TextBox x:Name="GainBox" Style="{StaticResource CardValue}" />
                <TextBlock Text="GAIN  dB" Style="{StaticResource CellCaption}" />
              </StackPanel>

              <StackPanel x:Name="QCell" Width="88" VerticalAlignment="Center">
                <TextBox x:Name="QBox" Style="{StaticResource CardValue}" />
                <TextBlock Text="Q" Style="{StaticResource CellCaption}" />
              </StackPanel>

              <StackPanel x:Name="SlopeCell" Width="88" Visibility="Collapsed"
                          VerticalAlignment="Center">
                <ComboBox x:Name="SlopeCombo" Style="{StaticResource Pill}" />
                <TextBlock Text="SLOPE" Style="{StaticResource CellCaption}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ComboBox x:Name="KindCombo" Style="{StaticResource Pill}" Width="124"
                    VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource Icon}" Data="{Binding Glyph}"
                        Stroke="{StaticResource Text}" StrokeThickness="1.4"
                        VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" Margin="7,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= preset drawer ================= -->
    <Rectangle x:Name="Scrim" Fill="#99000000" Opacity="0" Visibility="Collapsed" />

    <Border x:Name="Drawer" Width="320" HorizontalAlignment="Left" Visibility="Collapsed"
            Background="{StaticResource Panel}" BorderThickness="0,0,1,0"
            BorderBrush="{StaticResource Line}">
      <Border.RenderTransform>
        <TranslateTransform x:Name="DrawerSlide" X="-320" />
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.7" Color="#FF000000" />
      </Border.Effect>

      <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconBookmark}"
                  Stroke="{StaticResource Accent}" VerticalAlignment="Center" />
            <TextBlock Text="Presets" Foreground="{StaticResource Text}"
                       FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="SemiBold"
                       Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Button x:Name="DrawerCloseBtn" Style="{StaticResource GhostBtn}" Width="26" Height="26"
                  HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Close">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"
                  Width="14" Height="14" StrokeThickness="1.4" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>

            <TextBlock Text="LIBRARY" Style="{StaticResource SectionHead}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ComboBox x:Name="FolderCombo" Grid.Column="0" Style="{StaticResource SeamlessCombo}"
                        Margin="0,0,6,0" IsSynchronizedWithCurrentItem="False" />

              <Button x:Name="NewFolderBtn" Grid.Column="1" Style="{StaticResource MiniIconBtn}"
                      VerticalAlignment="Center" ToolTip="New group">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}"
                      Width="14" Height="14" StrokeThickness="1.4" />
              </Button>
              <Button x:Name="RenameFolderBtn" Grid.Column="2" Style="{StaticResource MiniIconBtn}"
                      VerticalAlignment="Center" ToolTip="Rename group">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconPencil}"
                      Width="14" Height="14" StrokeThickness="1.3" />
              </Button>
              <Button x:Name="DeleteFolderBtn" Grid.Column="3" Style="{StaticResource MiniIconBtn}"
                      VerticalAlignment="Center" ToolTip="Delete group">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}"
                      Width="14" Height="14" StrokeThickness="1.3" />
              </Button>
            </Grid>

            <Grid Margin="0,8,0,0">
              <ListBox x:Name="PresetList" Style="{StaticResource LibList}" MaxHeight="188"
                       IsSynchronizedWithCurrentItem="False">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" Margin="0,0,26,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                <Setter Property="FontStyle" Value="Italic" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <ToggleButton Style="{StaticResource SlotToggle}" Content="B"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding IsB, Mode=OneWay}"
                                    PreviewMouseLeftButtonDown="OnSlotToggleDown"
                                    ToolTip="Compare against this preset" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock x:Name="LibraryEmptyText" Style="{StaticResource Label}"
                         Foreground="{StaticResource TextFaint}" Margin="2,4,0,0"
                         Visibility="Collapsed" TextWrapping="Wrap" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
              <Button x:Name="SavePresetBtn" Style="{StaticResource FlatBtn}" Height="26" Width="136">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource Icon}" Data="{StaticResource IconSave}"
                        Width="14" Height="14" StrokeThickness="1.3" VerticalAlignment="Center" />
                  <TextBlock Text="Save" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="DeletePresetBtn" Style="{StaticResource FlatBtn}" Height="26" Width="136"
                      Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource Icon}" Data="{StaticResource IconTrash}"
                        Width="14" Height="14" StrokeThickness="1.3" VerticalAlignment="Center" />
                  <TextBlock Text="Delete" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18,0,16" />

            <Button x:Name="OpenSettingsBtn" Style="{StaticResource CardBtn}" Height="46">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Style="{StaticResource Icon}"
                      Data="{StaticResource IconSliders}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Settings" Foreground="{StaticResource Text}" FontSize="13"
                             FontFamily="{StaticResource UiFont}" />
                  <TextBlock x:Name="SettingsSummary" Style="{StaticResource Label}"
                             Foreground="{StaticResource TextFaint}" FontSize="10" Margin="0,1,0,0"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Path Grid.Column="2" Style="{StaticResource Icon}" Width="8" Height="14"
                      Data="M 0 0 L 5 7 L 0 14" Stretch="None" VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18,0,16" />

            <TextBlock Text="BANDS" Style="{StaticResource SectionHead}" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ImportBtn" Style="{StaticResource FlatBtn}" Height="26" Width="136"
                      ToolTip="AutoEq or Equalizer APO text file">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource Icon}" Data="{StaticResource IconImport}"
                        Width="14" Height="14" StrokeThickness="1.3" VerticalAlignment="Center" />
                  <TextBlock Text="Import…" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ClearBtn" Style="{StaticResource FlatBtn}" Height="26" Width="136"
                      Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"
                        Width="14" Height="14" StrokeThickness="1.3" VerticalAlignment="Center" />
                  <TextBlock Text="Clear all" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ================= settings page ================= -->
    <Grid x:Name="SettingsPage" Visibility="Collapsed">
      <Rectangle x:Name="PageScrim" Fill="#AA000000" Opacity="0" />

      <Border x:Name="PageCard" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource Panel}" CornerRadius="14" BorderThickness="1"
              BorderBrush="{StaticResource Edge}" Padding="20,16,20,18" Opacity="0"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <ScaleTransform x:Name="PageScale" ScaleX="0.97" ScaleY="0.97" />
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.7" Color="#FF000000" />
        </Border.Effect>

        <StackPanel>
          <Grid Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconSliders}"
                    Stroke="{StaticResource Accent}" VerticalAlignment="Center" />
              <TextBlock Text="Settings" Foreground="{StaticResource Text}"
                         FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="SemiBold"
                         Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="PageCloseBtn" Style="{StaticResource GhostBtn}" Width="26" Height="26"
                    HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Close">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"
                    Width="14" Height="14" StrokeThickness="1.4" />
            </Button>
          </Grid>

          <TextBlock Text="OUTPUT DEVICE" Style="{StaticResource SectionHead}" />
          <ComboBox x:Name="DeviceCombo" Style="{StaticResource SeamlessCombo}"
                    DisplayMemberPath="Display" IsSynchronizedWithCurrentItem="False" />

          <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18,0,16" />

          <TextBlock Text="PREAMP" Style="{StaticResource SectionHead}" />
          <Grid>
            <TextBox x:Name="PreampBox" Style="{StaticResource SeamlessField}" Width="90"
                     HorizontalAlignment="Left" />
            <CheckBox x:Name="AutoGainCheck" Style="{StaticResource Check}" Content="auto"
                      HorizontalAlignment="Left" Margin="106,0,0,0" IsChecked="True"
                      VerticalAlignment="Center" ToolTip="Derive the preamp from the curve" />
          </Grid>

          <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18,0,16" />

          <TextBlock Text="RANGE" Style="{StaticResource SectionHead}" />
          <ComboBox x:Name="RangeCombo" Style="{StaticResource SeamlessCombo}" Width="120"
                    HorizontalAlignment="Left" IsSynchronizedWithCurrentItem="False" />

          <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,18,0,16" />

          <TextBlock Text="LOUDNESS" Style="{StaticResource SectionHead}" />
          <CheckBox x:Name="FolderMatchCheck" Style="{StaticResource Check}" IsChecked="True"
                    Content="keep presets in a group equally loud"
                    ToolTip="Right-click a preset to exclude it" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= correction page ================= -->
    <Grid x:Name="CorrectionPage" Visibility="Collapsed">
      <Rectangle x:Name="CorrScrim" Fill="#AA000000" Opacity="0" />

      <Border x:Name="CorrCard" Width="760" Height="560"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource Panel}" CornerRadius="14" BorderThickness="1"
              BorderBrush="{StaticResource Edge}" Padding="20,16,20,16" Opacity="0"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <ScaleTransform x:Name="CorrScale" ScaleX="0.97" ScaleY="0.97" />
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.7" Color="#FF000000" />
        </Border.Effect>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconEars}"
                    Stroke="{StaticResource Accent}" VerticalAlignment="Center" />
              <TextBlock Text="Left / right correction" Foreground="{StaticResource Text}"
                         FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="SemiBold"
                         Margin="9,0,0,0" VerticalAlignment="Center" />
              <TextBlock x:Name="CorrFolderText" Style="{StaticResource Label}"
                         Margin="10,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="CorrCloseBtn" Style="{StaticResource GhostBtn}" Width="26" Height="26"
                    HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Close">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"
                    Width="14" Height="14" StrokeThickness="1.4" />
            </Button>
          </Grid>

          <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True"
                  BorderThickness="1" BorderBrush="{StaticResource LineSoft}">
            <c:EqCurveView x:Name="CorrCurve" />
          </Border>

          <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="PLACE ON" Style="{StaticResource SectionHead}" Margin="0,0,9,0"
                         VerticalAlignment="Center" />
              <ToggleButton x:Name="EarToggle" Style="{StaticResource EarSwitch}"
                            VerticalAlignment="Center" ToolTip="Ear for new bands" />
              <CheckBox x:Name="CorrEnabledCheck" Style="{StaticResource Check}" Content="applied"
                        Margin="18,0,0,0" IsChecked="True" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock x:Name="CorrSummaryText" Style="{StaticResource Label}"
                         Margin="0,0,12,0" VerticalAlignment="Center" />
              <Button x:Name="CorrClearBtn" Style="{StaticResource FlatBtn}" Content="Clear"
                      VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
