<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==== palette ==================================================== -->
  <Color x:Key="BgColor">#FF15120F</Color>
  <Color x:Key="PanelColor">#FF211C17</Color>
  <Color x:Key="DisplayColor">#FF0E0C0A</Color>
  <Color x:Key="AccentColor">#FFF2913D</Color>

  <SolidColorBrush x:Key="Bg" Color="#FF15120F" />
  <SolidColorBrush x:Key="Panel" Color="#FF211C17" />
  <SolidColorBrush x:Key="PanelHi" Color="#FF2D2620" />
  <SolidColorBrush x:Key="Sunken" Color="#FF171310" />
  <SolidColorBrush x:Key="Display" Color="#FF0E0C0A" />
  <SolidColorBrush x:Key="Line" Color="#FF3B322A" />
  <SolidColorBrush x:Key="LineSoft" Color="#FF2A241E" />
  <SolidColorBrush x:Key="Edge" Color="#FF463C31" />
  <SolidColorBrush x:Key="Text" Color="#FFEDE2D3" />
  <SolidColorBrush x:Key="TextDim" Color="#FFA0917E" />
  <SolidColorBrush x:Key="TextFaint" Color="#FF7A6C58" />
  <SolidColorBrush x:Key="Accent" Color="#FFF2913D" />
  <SolidColorBrush x:Key="AccentSoft" Color="#40F2913D" />
  <SolidColorBrush x:Key="AccentDim" Color="#55B86A28" />
  <SolidColorBrush x:Key="Warn" Color="#FFE8A33D" />
  <SolidColorBrush x:Key="Danger" Color="#FFE8776C" />

  <!-- ==== type ======================================================= -->
  <FontFamily x:Key="UiFont">Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <!-- ==== icons ====================================================== -->
  <PathGeometry x:Key="IconMenu"    Figures="M1,3 H15 M1,8 H15 M1,13 H15" />
  <PathGeometry x:Key="IconClose"   Figures="M3,3 L13,13 M13,3 L3,13" />
  <PathGeometry x:Key="IconSliders"
                Figures="M1,4.5 H15 M1,11.5 H15
                         M4,4.5 A2,2 0 1 0 8,4.5 A2,2 0 1 0 4,4.5
                         M8,11.5 A2,2 0 1 0 12,11.5 A2,2 0 1 0 8,11.5" />
  <PathGeometry x:Key="IconSave"    Figures="M2,2 H10.5 L14,5.5 V14 H2 Z M5,2 V6 H11 M5,14 V9.5 H11 V14" />
  <PathGeometry x:Key="IconTrash"   Figures="M2,4 H14 M6,4 V2 H10 V4 M3.5,4 L4.4,14.5 H11.6 L12.5,4" />
  <PathGeometry x:Key="IconImport"  Figures="M8,1.5 V9.5 M4.5,6.5 L8,10 L11.5,6.5 M2,13.5 H14" />
  <PathGeometry x:Key="IconBookmark" Figures="M3.5,1.5 H12.5 V14.5 L8,10.8 L3.5,14.5 Z" />
  <PathGeometry x:Key="IconChevron" Figures="M0,0 L4,4 L8,0" />
  <PathGeometry x:Key="IconPlus"    Figures="M8,2.5 V13.5 M2.5,8 H13.5" />

  <PathGeometry x:Key="IconFilterBell"      Figures="M1,12 C4,12 4.5,4 8,4 C11.5,4 12,12 15,12" />
  <PathGeometry x:Key="IconFilterLowShelf"  Figures="M1,4 C4,4 4.5,12 8,12 L15,12" />
  <PathGeometry x:Key="IconFilterHighShelf" Figures="M1,12 L8,12 C11.5,12 12,4 15,4" />
  <PathGeometry x:Key="IconFilterLowCut"    Figures="M1,15 C5,15 5,5 9,5 L15,5" />
  <PathGeometry x:Key="IconFilterHighCut"   Figures="M1,5 L7,5 C11,5 11,15 15,15" />
  <PathGeometry x:Key="IconFilterNotch"     Figures="M1,5 L6,5 L8,14 L10,5 L15,5" />
  <PathGeometry x:Key="IconFilterBandPass"  Figures="M1,15 C5,15 5.5,4 8,4 C10.5,4 11,15 15,15" />
  <PathGeometry x:Key="IconFilterAllPass"
                Figures="M1,6 H15
                         M1,13 C3,13 3,10 5.5,10 C8,10 8,13 10.5,13 C13,13 13,10 15,10" />
  <PathGeometry x:Key="IconPencil"  Figures="M2.5,13.5 L3.3,10.3 L10.6,3 L13,5.4 L5.7,12.7 Z M9.2,4.4 L11.6,6.8" />
  <PathGeometry x:Key="IconFolder"  Figures="M1.5,3.5 H6.2 L7.8,5.6 H14.5 V13 H1.5 Z" />

  <PathGeometry x:Key="IconEars"
                Figures="M6,13.5 C6,10.5 2.5,10 2.5,6.5 A3.5,3.5 0 0 1 6,3 M10,13.5 C10,10.5 13.5,10 13.5,6.5 A3.5,3.5 0 0 0 10,3" />

  <Style x:Key="Icon" TargetType="Path">
    <Setter Property="Stroke" Value="{StaticResource TextDim}" />
    <Setter Property="StrokeThickness" Value="1.4" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ==== text ======================================================= -->
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Label}">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CellCaption" TargetType="TextBlock" BasedOn="{StaticResource Label}">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <Style x:Key="SectionHead" TargetType="TextBlock" BasedOn="{StaticResource Label}">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    <Setter Property="Margin" Value="0,0,0,7" />
  </Style>

  <!-- ==== parameter cells ============================================ -->
  <Style x:Key="Value" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Height" Value="23" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}"
                  BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF2A231C" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF120F0D" />
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CardValue" TargetType="TextBox" BasedOn="{StaticResource Value}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Height" Value="26" />
  </Style>

  <Style x:Key="VDivider" TargetType="Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{StaticResource Line}" />
    <Setter Property="Margin" Value="10,4,10,6" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ==== buttons ==================================================== -->
  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource PanelHi}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}"
                  CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Edge}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF3A312A" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF191512" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
              <Setter TargetName="b" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Toggle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="{StaticResource PanelHi}"
                  CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Edge}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF3A312A" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource AccentDim}" />
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Foreground" Value="#FF15120F" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{StaticResource Accent}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FFFFA64F" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FFD97C2C" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{StaticResource Danger}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FFF08D82" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FFCC5F54" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FlatBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}"
                  CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource LineSoft}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF322A23" />
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Edge}" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF171310" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CardBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="#FF1B1713" />
    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9"
                  BorderThickness="1" BorderBrush="{StaticResource LineSoft}">
            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF272019" />
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Edge}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF171310" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FlatToggle" TargetType="ToggleButton" BasedOn="{StaticResource Toggle}">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="Transparent"
                  CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource LineSoft}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF322A23" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource AccentDim}" />
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PillToggle" TargetType="ToggleButton" BasedOn="{StaticResource Toggle}">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="#FF191512" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" CornerRadius="13">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Edge}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource AccentDim}" />
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==== the band node ============================================== -->
  <Style x:Key="NodePower" TargetType="ToggleButton">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Foreground" Value="#FF15120F" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Ellipse x:Name="dish" Width="40" Height="40" Fill="{StaticResource Sunken}" />

            <Path x:Name="ring" Width="42" Height="42" Stretch="None"
                  Data="M29.55,3.47 A19.5,19.5 0 1 1 12.45,3.47 M21,2.2 V8.4"
                  Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

            <Ellipse x:Name="swatch" Width="24" Height="24"
                     Fill="{TemplateBinding Background}" />

            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="swatch" Property="Opacity" Value="0.22" />
              <Setter TargetName="ring" Property="Stroke" Value="{StaticResource TextFaint}" />
              <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}" />
              <Setter TargetName="dish" Property="Fill" Value="#FF221C17" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent" CornerRadius="13"
                  BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF3A231F" />
              <Setter TargetName="b" Property="BorderBrush" Value="#FF8C4438" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF24140F" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MiniIconBtn" TargetType="Button">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent" CornerRadius="6"
                  BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF2A231C" />
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineSoft}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF171310" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostBtn" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent" CornerRadius="8"
                  BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF2A231C" />
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineSoft}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#FF171310" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==== the EQ switch ============================================== -->
  <Style x:Key="EqSwitch" TargetType="ToggleButton">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="24" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="track" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{StaticResource Edge}">
              <Border.Background>
                <SolidColorBrush x:Name="trackFill" Color="#FF241E19" />
              </Border.Background>
            </Border>

            <Border x:Name="glow" CornerRadius="12" Background="{StaticResource AccentSoft}"
                    Opacity="0" />

            <Border x:Name="thumb" Width="18" Height="18" CornerRadius="9"
                    HorizontalAlignment="Left" Margin="3,0,0,0">
              <Border.Background>
                <SolidColorBrush x:Name="thumbFill" Color="#FF7A6C58" />
              </Border.Background>
              <Border.RenderTransform>
                <TranslateTransform X="0" />
              </Border.RenderTransform>
            </Border>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="thumb"
                                     Storyboard.TargetProperty="RenderTransform.X"
                                     To="22" Duration="0:0:0.20">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <ColorAnimation Storyboard.TargetName="trackFill"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF5A3517" Duration="0:0:0.20" />
                    <ColorAnimation Storyboard.TargetName="thumbFill"
                                    Storyboard.TargetProperty="Color"
                                    To="#FFF2913D" Duration="0:0:0.20" />
                    <DoubleAnimation Storyboard.TargetName="glow"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0.35" Duration="0:0:0.28" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="thumb"
                                     Storyboard.TargetProperty="RenderTransform.X"
                                     To="0" Duration="0:0:0.20">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <ColorAnimation Storyboard.TargetName="trackFill"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF241E19" Duration="0:0:0.20" />
                    <ColorAnimation Storyboard.TargetName="thumbFill"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF7A6C58" Duration="0:0:0.20" />
                    <DoubleAnimation Storyboard.TargetName="glow"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.18" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==== the A/B switch ============================================= -->
  <Style x:Key="AbSwitch" TargetType="ToggleButton">
    <Setter Property="Width" Value="58" />
    <Setter Property="Height" Value="24" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="slide"
                                     Storyboard.TargetProperty="X"
                                     To="0" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <ColorAnimation Storyboard.TargetName="aFill"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF15120F" Duration="0:0:0.14" />
                    <ColorAnimation Storyboard.TargetName="bFill"
                                    Storyboard.TargetProperty="Color"
                                    To="#FFA0917E" Duration="0:0:0.14" />
                  </Storyboard>
                </VisualState>

                <VisualState x:Name="Checked">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="slide"
                                     Storyboard.TargetProperty="X"
                                     To="27" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <ColorAnimation Storyboard.TargetName="aFill"
                                    Storyboard.TargetProperty="Color"
                                    To="#FFA0917E" Duration="0:0:0.14" />
                    <ColorAnimation Storyboard.TargetName="bFill"
                                    Storyboard.TargetProperty="Color"
                                    To="#FF15120F" Duration="0:0:0.14" />
                  </Storyboard>
                </VisualState>

                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="track" CornerRadius="12" Background="#FF191512"
                    BorderThickness="1" BorderBrush="{StaticResource Edge}" />

            <Border x:Name="thumb" Width="27" Height="20" CornerRadius="10"
                    HorizontalAlignment="Left" Margin="2,0,0,0"
                    Background="{StaticResource Accent}">
              <Border.RenderTransform>
                <TranslateTransform x:Name="slide" X="0" />
              </Border.RenderTransform>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="A"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Foreground>
                  <SolidColorBrush x:Name="aFill" Color="#FF15120F" />
                </TextBlock.Foreground>
              </TextBlock>
              <TextBlock Grid.Column="1" Text="B"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Foreground>
                  <SolidColorBrush x:Name="bFill" Color="#FFA0917E" />
                </TextBlock.Foreground>
              </TextBlock>
            </Grid>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

